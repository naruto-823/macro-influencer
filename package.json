{
  "name": "macro-influencer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "百万网红 Agent — 人设驱动的小红书图文选题与成稿流水线",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9"
  },
  "bin": {
    "influencer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "tsx src/cli.ts",
    "node-run": "tsx src/node-cli.ts",
    "publish": "tsx src/publish/publish-cli.ts",
    "publish:auth": "tsx src/publish/auth-setup.ts",
    "publish:xhs": "tsx src/publish/xhs-driver.ts",
    "viz": "tsx src/viz/server.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "daily": "tsx src/publish/daily.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/pngjs": "^6.0.5",
    "pg": "^8.22.0",
    "playwright-core": "^1.62.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
