# 复制为 .env 后填入（.env 已 gitignore，不会进版本库）。
# Claude / Anthropic：可走官方，也可走公司合规代理（fox）。三项与 ug-agents 一致。
ANTHROPIC_API_KEY=
# 公司合规代理地址（fox）；留空则走 Anthropic 官方
ANTHROPIC_BASE_URL=
# 模型：claude-sonnet-4-6 / claude-opus-4-7 / claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6

# 官方微博实时热搜（可选）：登录 s.weibo.com 后从 DevTools 复制热搜请求的 cookie 串。
# 不填则微博源跳过（知乎/抖音/头条公开源仍可用），不影响其它热点。cookie 过期需重取。
WEIBO_COOKIE=
